#!/bin/bash
# Equinox app configs: link only while the active theme ships the file.
set -u

theme_dir="$HOME/.local/state/omarchy/current/theme"

link_file() {
  local name="$1" dest="$2"
  if [ -f "$theme_dir/$name" ]; then
    mkdir -p "${dest%/*}"
    ln -sfn "$theme_dir/$name" "$dest"
  elif [ -L "$dest" ] && [ ! -e "$dest" ]; then
    rm -f "$dest"
  fi
}

link_file fastfetch.jsonc "$HOME/.config/fastfetch/config.jsonc"
link_file lazygit.yml "$HOME/.config/lazygit/config.yml"

vencord_name=""
if [ -f "$theme_dir/vencord.theme.css" ]; then
  mkdir -p "$HOME/.config/Vencord/themes"
  cp "$theme_dir/vencord.theme.css" "$HOME/.config/Vencord/themes/equinox.theme.css"
  vencord_name="equinox.theme.css"
fi

vencord_settings="$HOME/.config/Vencord/settings/settings.json"
if [ -f "$vencord_settings" ] && command -v python3 >/dev/null 2>&1; then
  python3 - "$vencord_settings" "$vencord_name" <<'PY'
import json
import sys

path, name = sys.argv[1], sys.argv[2]
with open(path) as fh:
    data = json.load(fh)
themes = [t for t in data.get("enabledThemes", []) if t != "equinox.theme.css"]
if name:
    themes.append(name)
data["enabledThemes"] = themes
with open(path, "w") as fh:
    json.dump(data, fh, indent=2)
PY
fi
